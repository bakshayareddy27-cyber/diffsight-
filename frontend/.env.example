# DiffSight Frontend – Environment Variables
# Copy this file to .env.local and fill in the values for local development.
# On Render, set these as environment variables in the dashboard or via render.yaml.

# WebSocket URL pointing to the DiffSight backend.
# For local dev this defaults to ws://localhost:8000/ws/analyze (no value needed).
# For production, set to your Render backend service URL:
# Example: wss://diffsight-backend.onrender.com/ws/analyze
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/analyze
