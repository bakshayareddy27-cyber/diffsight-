# DiffSight Backend – Environment Variables
# Copy this file to .env and fill in the values for local development.
# On Render, set these as environment variables in the dashboard or via render.yaml.

# Comma-separated list of allowed CORS origins.
# Example for production: https://diffsight-frontend.onrender.com
DIFFSIGHT_ORIGINS=http://localhost:3000

# Host and port for uvicorn (used only when running locally via `python -m uvicorn`)
HOST=0.0.0.0
PORT=8000
